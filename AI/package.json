{
  "name": "purity-mcp",
  "version": "1.0.0",
  "description": "Official Model Context Protocol (MCP) server for the Purity framework - Supercharging AI-assisted development with scaffolding, code validation, component inspection, API documentation, and template conversion",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "purity-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "purity",
    "purity-world",
    "ai",
    "scaffolding",
    "linter",
    "signals",
    "custom-elements",
    "adwaita"
  ],
  "author": "Purity Framework Team",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
