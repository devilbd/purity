{
  "compilerOptions": {
    "target": "ES2023",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "paths": {
      "@purity/core": ["./src/framework/core.ts"],
      "@purity/*": ["./src/framework/*"],
      "@environments": ["./src/environments/environment.ts"],
      "@environments/*": ["./src/environments/*"],
      "@data/*": ["./src/data/*"],
      "@app/*": ["./src/app/*"],
      "@pages/*": ["./src/app/pages/*"],
      "@shared/*": ["./src/app/shared/*"],
      "@components/*": ["./src/app/shared/components/*"],
      "@directives/*": ["./src/app/shared/directives/*"],
      "@pipes/*": ["./src/app/shared/pipes/*"],
      "@validators/*": ["./src/app/shared/validators/*"],
      "@behaviors/*": ["./src/app/shared/behaviors/*"],
      "@interceptors/*": ["./src/app/shared/interceptors/*"],
      "@widgets/*": ["./src/app/shared/widgets/*"],
      "@styles": ["./src/style.scss"],
      "@styles/*": ["./src/*"]
    },

    /* Linting */
    "experimentalDecorators": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"]
}
