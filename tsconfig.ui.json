{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "./npm-publish-ui/types",
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "paths": {
      "@purity/core": ["./src/framework/core.ts"],
      "@purity/*": ["./src/framework/*"],
      "@data/*": ["./src/data/*"],
      "@app/*": ["./src/app/*"],
      "@pages/*": ["./src/app/pages/*"],
      "@shared/*": ["./src/app/shared/*"],
      "@components/*": ["./src/app/shared/components/*"],
      "@directives/*": ["./src/app/shared/directives/*"],
      "@pipes/*": ["./src/app/shared/pipes/*"],
      "@validators/*": ["./src/app/shared/validators/*"],
      "@behaviors/*": ["./src/app/shared/behaviors/*"],
      "@interceptors/*": ["./src/app/shared/interceptors/*"],
      "@widgets/*": ["./src/app/shared/widgets/*"],
      "@styles": ["./src/styles/index.scss"]
    }
  },
  "include": [
    "src/ui.ts",
    "src/app/shared/**/*",
    "src/data/theme.service.ts",
    "src/data/notify.service.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
